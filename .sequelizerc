const path = require('path');

// Buscamos dinámicamente dónde está guardado realmente el archivo config.js
const baseDir = __dirname.endsWith('papel-y-luna') 
  ? __dirname 
  : path.join(__dirname, 'papel-y-luna');

module.exports = {
  'config': path.join(baseDir, 'src', 'config', 'config.js'),
  'models-path': path.join(baseDir, 'src', 'models'),
  'seeders-path': path.join(baseDir, 'src', 'seeders'),
  'migrations-path': path.join(baseDir, 'src', 'migrations')
};