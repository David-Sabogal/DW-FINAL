const path = require('path');

// Buscamos la carpeta del proyecto sin asumir que existe una carpeta 'src'
const baseDir = __dirname.endsWith('papel-y-luna') 
  ? __dirname 
  : path.join(__dirname, 'papel-y-luna');

module.exports = {
  'config': path.join(baseDir, 'config', 'config.js'),
  'models-path': path.join(baseDir, 'models'),
  'seeders-path': path.join(baseDir, 'seeders'),
  'migrations-path': path.join(baseDir, 'migrations')
};